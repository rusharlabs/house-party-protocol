{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "handoff-v1.1.schema.json",
  "title": "Handoff v1.1",
  "description": "Contrato do artefato de handoff entre sessões (continuity-kit). v1.1 sobre o v1.0: bloco git obrigatório, stale_when.head_moved, degraded-auto com git status --porcelain, schema FORMAL (max_bytes:65536).",
  "type": "object",
  "required": ["schema_version", "handoff_id", "created_at", "trigger", "quality", "session", "estado", "git", "valid_until"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "1.1" },
    "handoff_id": { "type": "string", "pattern": "^HO-\\d{8}-\\d{4}-[a-z0-9-]+$" },
    "created_at": { "type": "string", "format": "date-time" },
    "trigger": { "type": "string", "enum": ["pre-clear", "precompact", "stop", "manual", "degraded-auto"] },
    "quality": { "type": "string", "enum": ["full", "degraded-auto"] },

    "session": {
      "type": "object",
      "required": ["session_id", "lane_id"],
      "additionalProperties": false,
      "properties": {
        "session_id": { "type": "string" },
        "lane_id": { "type": "string", "default": "solo" },
        "role": { "type": "string", "enum": ["executora", "planejadora", "revisora", "solo"] },
        "model": { "type": "string" },
        "branch": { "type": "string" },
        "cwd": { "type": "string" }
      }
    },

    "git": {
      "type": "object",
      "description": "OBRIGATÓRIO (correção v1.1) — sem isto, staleness por HEAD (stale_when.head_moved) não é calculável.",
      "required": ["head", "branch", "dirty", "untracked"],
      "additionalProperties": false,
      "properties": {
        "head": { "type": "string", "description": "sha curto do HEAD no momento da escrita" },
        "branch": { "type": "string" },
        "dirty": { "type": "boolean" },
        "untracked": { "type": "integer", "minimum": 0 },
        "porcelain": { "type": "string", "description": "saída crua de git status --porcelain (obrigatória em quality=degraded-auto)" }
      }
    },

    "stale_when": {
      "type": "object",
      "description": "Correção v1.1 — staleness por delta de commit, não só por relógio: a árvore andou = proximo_passo não-acionável mesmo dentro do valid_until.",
      "additionalProperties": false,
      "properties": {
        "head_moved": { "type": "boolean", "description": "true se HEAD atual != git.head no momento da injeção (calculado em runtime pelo handoff_inject.py, não gravado na escrita)" },
        "days": { "type": "integer", "minimum": 1, "default": 7 }
      }
    },

    "estado": {
      "type": "object",
      "required": ["resumo"],
      "additionalProperties": false,
      "properties": {
        "resumo": { "type": "string", "minLength": 1 },
        "fase": { "type": "string" },
        "numeros": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["metrica", "valor", "medido_em", "re_derive_cmd"],
            "properties": {
              "metrica": { "type": "string" },
              "valor": { "type": "string" },
              "medido_em": { "type": "string", "format": "date-time" },
              "re_derive_cmd": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },

    "decisoes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "decisao"],
        "properties": {
          "id": { "type": "string" },
          "decisao": { "type": "string" },
          "motivo": { "type": "string" },
          "evidencia": { "type": "string" }
        }
      }
    },

    "gates_abertos": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "dono", "descricao"],
        "properties": {
          "id": { "type": "string" },
          "dono": { "type": "string" },
          "descricao": { "type": "string" },
          "bloqueia": { "type": "string" },
          "comando_destrava": { "type": "string" }
        }
      }
    },

    "proibicoes": { "type": "array", "items": { "type": "string" } },

    "ja_executado": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["acao", "evidencia"],
        "properties": {
          "acao": { "type": "string" },
          "evidencia": { "type": "string" },
          "nunca_repetir": { "type": "boolean", "default": true }
        }
      }
    },

    "proximo_passo": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["ordem", "descricao", "verify_first_cmd"],
        "properties": {
          "ordem": { "type": "integer", "minimum": 1 },
          "descricao": { "type": "string" },
          "done_predicate": { "type": "string" },
          "verify_first_cmd": { "type": "string", "minLength": 1, "description": "comando que prova se JÁ foi feito (LC-4) — obrigatório" },
          "idempotente": { "type": "boolean", "default": false }
        }
      }
    },

    "evidencias": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["tipo", "ref"],
        "properties": {
          "tipo": { "type": "string", "enum": ["commit", "arquivo", "http", "cmd"] },
          "ref": { "type": "string" },
          "valor": { "type": "string" }
        }
      }
    },

    "todos_snapshot": { "type": "array", "items": { "type": "string" } },

    "valid_until": { "type": "string", "format": "date-time" },
    "boot_docs": { "type": "array", "items": { "type": "string" } }
  },

  "max_bytes": 65536
}
