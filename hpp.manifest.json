{
  "protocol_version": "2.1",
  "product_version": "2.5.4",
  "name": "house-party-protocol",
  "hosts": [
    "claude-code",
    "codex"
  ],
  "invariants": [
    "A verified outcome has recorded evidence and an explicit human gate.",
    "A checker is read-only relative to the maker's workspace.",
    "A loop advances only through a recorded event.",
    "An approval is invalid when its bound spec, commit, or repository snapshot changes."
  ],
  "roles": [
    "maker",
    "checker",
    "human-gate"
  ],
  "exit_codes": {
    "ok": 0,
    "warn": 1,
    "block": 2,
    "error": 3
  },
  "hook_capabilities": [
    "automatic-source-writes",
    "command-rewrite-and-process-control",
    "transcript-derived-llm-egress",
    "mcp-network-and-process-activity",
    "automatic-permission-gates",
    "session-observation-and-cost-records"
  ],
  "maps": [
    "capability",
    "agent",
    "lane",
    "work",
    "operational",
    "execution",
    "evidence",
    "code",
    "context",
    "monitor"
  ],
  "routing": {
    "tiers": [
      "economy",
      "balanced",
      "frontier"
    ],
    "rule": "Risk and context define a floor; fallback may only move upward."
  },
  "installer": {
    "path": "installers/kit-forge-1.4.1/kit_doctor.py"
  },
  "loop": {
    "initial": "planned",
    "transitions": [
      {
        "from": "planned",
        "event": "work_started",
        "to": "active",
        "gate": "scope"
      },
      {
        "from": "active",
        "event": "evidence_recorded",
        "to": "evidenced",
        "gate": "fresh-evidence"
      },
      {
        "from": "evidenced",
        "event": "check_passed",
        "to": "checked",
        "gate": "read-only-checker"
      },
      {
        "from": "checked",
        "event": "human_approved",
        "to": "approved",
        "gate": "human"
      },
      {
        "from": "approved",
        "event": "verified",
        "to": "verified",
        "gate": "closure"
      }
    ]
  },
  "modules": [
    {
      "id": "operator-kit",
      "version": "1.5.0",
      "path": "frameworks/operator-kit-1.5.0",
      "requires": [],
