  "monitors": [
    {
      "id": "harness-doctor",
      "target": "hpp.manifest.json",
      "type": "command",
      "cadence": 300,
      "freshness": 600,
      "severity": "block",
      "cost": "low",
      "consumer_gate": "release"
    },
    {
      "id": "event-freshness",
      "target": ".hpp/events.jsonl",
      "type": "timestamp",
      "cadence": 60,
      "freshness": 300,
      "severity": "warn",
      "cost": "low",
      "consumer_gate": "resume"
    },
    {
      "id": "distribution-integrity",
      "target": "marketplace.json",
      "type": "checksum",
      "cadence": 3600,
      "freshness": 86400,
      "severity": "block",
      "cost": "medium",
      "consumer_gate": "publish"
    }
  ],
