{
  "protocol_version": "2.0",
  "product_version": "2.2.0",
  "name": "house-party-protocol",
  "hosts": ["claude-code", "codex"],
  "invariants": [
    "A verified outcome has recorded evidence and an explicit human gate.",
    "A checker is read-only relative to the maker's workspace.",
    "A loop advances only through a recorded event.",
    "An approval is invalid when its bound spec, commit, or repository snapshot changes."
  ],
  "roles": ["maker", "checker", "human-gate"],
  "exit_codes": {"ok": 0, "warn": 1, "block": 2, "error": 3},
  "maps": ["capability", "agent", "lane", "work", "operational", "execution", "evidence", "code", "context", "monitor"],
  "routing": {
    "tiers": ["economy", "balanced", "frontier"],
    "rule": "Risk and context define a floor; fallback may only move upward."
  },
  "installer": {"path": "instaladores/kit-forge-1.4.0/kit_doctor.py"},
  "loop": {
    "initial": "planned",
    "transitions": [
      {"from": "planned", "event": "work_started", "to": "active", "gate": "scope"},
      {"from": "active", "event": "evidence_recorded", "to": "evidenced", "gate": "fresh-evidence"},
      {"from": "evidenced", "event": "check_passed", "to": "checked", "gate": "read-only-checker"},
      {"from": "checked", "event": "human_approved", "to": "approved", "gate": "human"},
      {"from": "approved", "event": "verified", "to": "verified", "gate": "closure"}
    ]
  },
  "modules": [
    {"id": "operator-kit", "version": "1.4.0", "path": "frameworks-com-plugins/operator-kit-1.4.0", "requires": [], "integrates_with": ["continuity-kit", "lane-kit"], "capabilities": ["evidence-gate", "evidence-attestation", "loop-control", "policy", "workflow.spec-driven", "workflow.waves"], "hosts": {"claude-code": "native", "codex": "explicit-command"}, "components": ["skills", "commands", "hooks", "rules"]},
    {"id": "kit-forge", "version": "1.4.0", "path": "instaladores/kit-forge-1.4.0", "requires": [], "integrates_with": ["claude-dev-kit"], "capabilities": ["deterministic-build", "supply-chain"], "hosts": {"claude-code": "explicit-command", "codex": "explicit-command"}, "components": ["scripts", "templates"]},
    {"id": "lane-kit", "version": "1.2.0", "path": "multi-sessao/lane-kit-1.2.0", "requires": [], "integrates_with": ["continuity-kit", "operator-kit"], "capabilities": ["lane-isolation", "read-only-checker", "coordination.lane-map"], "hosts": {"claude-code": "native", "codex": "explicit-command"}, "components": ["hooks", "agents", "commands"]},
    {"id": "continuity-kit", "version": "1.2.1", "path": "continuidade/continuity-kit-1.2.1", "requires": [], "integrates_with": ["lane-kit", "gotcha-memory"], "capabilities": ["handoff", "event-resume"], "hosts": {"claude-code": "native", "codex": "explicit-command"}, "components": ["hooks", "templates", "skills"]},
    {"id": "health-kit", "version": "1.3.1", "path": "frameworks-com-plugins/health-kit-1.3.1", "requires": [], "integrates_with": ["operator-kit"], "capabilities": ["service-health", "data-freshness"], "hosts": {"claude-code": "explicit-command", "codex": "explicit-command"}, "components": ["scripts", "skills"]},
    {"id": "claude-dev-kit", "version": "1.3.1", "path": "frameworks-com-plugins/claude-dev-kit-1.3.1", "requires": [], "integrates_with": ["kit-forge"], "capabilities": ["tooling-scaffold", "secret-scan"], "hosts": {"claude-code": "native", "codex": "unsupported"}, "components": ["skills", "scripts"]},
    {"id": "supabase-pack", "version": "1.1.0", "path": "frameworks-com-plugins/supabase-pack-1.1.0", "requires": [], "integrates_with": ["operator-kit"], "capabilities": ["database-audit"], "hosts": {"claude-code": "explicit-command", "codex": "explicit-command"}, "components": ["skills", "scripts"]},
    {"id": "agent-framework-wizard", "version": "1.1.1", "path": "wizards/agent-framework-wizard-1.1.1", "requires": [], "integrates_with": ["claude-dev-kit", "kit-forge"], "capabilities": ["agent-scaffold"], "hosts": {"claude-code": "explicit-command", "codex": "explicit-command"}, "components": ["commands", "templates"]},
    {"id": "dev-squad-kit", "version": "1.0.0", "path": "frameworks-com-plugins/dev-squad-kit-1.0.0", "requires": [], "integrates_with": ["operator-kit", "lane-kit"], "capabilities": ["agent-roles", "parallel-review", "routing.model-policy", "context.compile"], "hosts": {"claude-code": "native", "codex": "explicit-command"}, "components": ["agents", "commands", "skills"]},
    {"id": "gotcha-memory", "version": "1.0.0", "path": "continuidade/gotcha-memory-1.0.0", "requires": [], "integrates_with": ["continuity-kit", "operator-kit"], "capabilities": ["failure-memory", "preflight-learning"], "hosts": {"claude-code": "native", "codex": "explicit-command"}, "components": ["hooks", "skills", "templates"]}
  ],
  "monitors": [
    {"id": "harness-doctor", "target": "hpp.manifest.json", "type": "command", "cadence": 300, "freshness": 600, "severity": "block", "cost": "low", "consumer_gate": "release"},
    {"id": "event-freshness", "target": ".hpp/events.jsonl", "type": "timestamp", "cadence": 60, "freshness": 300, "severity": "warn", "cost": "low", "consumer_gate": "resume"},
    {"id": "distribution-integrity", "target": "marketplace.json", "type": "checksum", "cadence": 3600, "freshness": 86400, "severity": "block", "cost": "medium", "consumer_gate": "publish"}
  ],
  "bundles": {
    "reliable-coding": {
      "modules": ["operator-kit", "kit-forge", "lane-kit", "continuity-kit", "health-kit", "gotcha-memory"],
      "capabilities": ["evidence-gate", "evidence-attestation", "loop-control", "policy", "deterministic-build", "lane-isolation", "read-only-checker", "handoff", "event-resume", "service-health", "data-freshness", "failure-memory", "preflight-learning"]
    }
  }
}
