{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "ruleset.schema.json",
  "title": "IP/PII Ruleset v1",
  "description": "Contract of the ip-ruleset.yaml consumed by ip_pii_linter.py. See installers/kit-forge/ip_pii_linter.py.",
  "type": "object",
  "required": ["version"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "integer" },
    "banned_terms": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "clients": { "type": "array", "items": { "type": "string" } },
        "infra": { "type": "array", "items": { "type": "string" } },
        "identity": { "type": "array", "items": { "type": "string" } }
      }
    },
    "derived": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "filenames": { "type": "array", "items": { "type": "string" } },
        "content": { "type": "array", "items": { "type": "string" } },
        "reference_only_ok": { "type": "array", "items": { "type": "string" } },
        "attribution_required_if_missing": { "type": "array", "items": { "type": "string" } }
      }
    },
    "pii": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "personal_emails": { "type": "array", "items": { "type": "string" } }
      }
    },
    "allow": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "pattern", "categoria", "justificativa", "autor", "data"],
        "properties": {
          "path": { "type": "string" },
          "pattern": { "type": "string" },
          "categoria": { "type": "string", "enum": ["secret", "client", "infra", "pii", "identity", "derived", "hygiene"] },
          "justificativa": { "type": "string" },
          "autor": { "type": "string" },
          "data": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
        }
      }
    }
  }
}
